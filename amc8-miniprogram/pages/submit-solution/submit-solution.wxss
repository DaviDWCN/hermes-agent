/* pages/submit-solution/submit-solution.wxss */

.page-wrap { background: var(--color-bg); padding-bottom: 80rpx; }
.mx-24 { margin-left: 24rpx; margin-right: 24rpx; }
.section { }

.q-preview-card {}
.q-preview-text {
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Method chips */
.tag-scroll { white-space: nowrap; }
.tag-row { display: inline-flex; gap: 12rpx; }

.method-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  background: var(--color-primary-pale);
  color: var(--color-primary);
  font-weight: 500;
  white-space: nowrap;
}

.method-chip-active {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* Shortcut bar */
.shortcut-scroll { white-space: nowrap; }
.shortcut-row { display: inline-flex; gap: 10rpx; padding-bottom: 8rpx; }

.shortcut-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #F0F4FF;
  color: var(--color-primary);
  border: 1rpx solid var(--color-border);
  white-space: nowrap;
  font-family: var(--font-mono);
}

.shortcut-chip:active {
  background: var(--color-primary);
  color: #fff;
}

.hint-note { font-size: 20rpx; display: block; margin-top: 8rpx; }

/* Textarea */
.solution-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  font-family: var(--font-mono);
  color: var(--color-text-primary);
  box-sizing: border-box;
  margin-top: 12rpx;
}

/* Image grid */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.img-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.img-add-icon { font-size: 60rpx; color: var(--color-text-muted); }
.img-add-label { font-size: 22rpx; color: var(--color-text-muted); }

/* Submit */
.submit-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.submit-btn {
  width: 100%;
  padding: 28rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}

.btn-disabled { opacity: 0.6; }

.submit-note { text-align: center; font-size: 20rpx; display: block; }
